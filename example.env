# =========================================================
# LaptopERP Enterprise Environment Configuration Template
# Copy this file to .env and configure for your environment
# =========================================================

# Security Key (Generate a new secure secret key for production)
DJANGO_SECRET_KEY=replace-with-your-generated-django-secret-key-32-chars-minimum

# Environment Mode (Set to False in Production)
DEBUG=True

# Host Configurations (Comma-separated hostnames or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# MySQL Configuration (Uncomment and set if using MySQL container/service)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=laptoperp_db
# DB_USER=laptoperp_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Enterprise Company Configuration
ERP_COMPANY_NAME=LaptopERP Solutions Inc.
ERP_CURRENCY_SYMBOL=$
ERP_DEFAULT_TAX_RATE=18.00
ERP_WARRANTY_DEFAULT_MONTHS=12
